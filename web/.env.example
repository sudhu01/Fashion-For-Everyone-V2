# =============================================================================
# Fashion For Everyone — environment variables
#
# Copy to `.env.local` for local development and to your hosting provider's
# secret store for production. Never commit a real `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Postgres)
# -----------------------------------------------------------------------------
# Pooled connection used by the running app at runtime. With Supabase / Neon,
# this is the pgbouncer-fronted URL ending in `?pgbouncer=true&connection_limit=1`.
DATABASE_URL="postgresql://user:password@host:5432/fashion_for_everyone?schema=public"

# Optional direct (non-pooled) connection used by `prisma migrate`. Required on
# any host that puts a connection pooler in front of Postgres (Supabase, Neon).
# Leave unset to fall back to DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/fashion_for_everyone?schema=public"

# -----------------------------------------------------------------------------
# Clerk (auth)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Webhook signing secret from Clerk dashboard → Webhooks → Endpoint → Signing.
# Used by /api/webhooks/clerk to verify Svix signatures.
CLERK_WEBHOOK_SECRET="whsec_..."

# Optional: override Clerk's default redirects (see Clerk docs).
# NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
# NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# -----------------------------------------------------------------------------
# fal.ai (image generation)
# -----------------------------------------------------------------------------
# API key from https://fal.ai/dashboard/keys. Kept server-side only.
FAL_KEY=""
# fal model slug. FLUX.2 Klein with a custom LoRA is served through fal's
# flux-lora family; adjust to match your deployed endpoint. Examples:
#   fal-ai/flux-lora
#   fal-ai/flux/dev
#   fal-ai/flux-2/klein            (if/when fal exposes a Klein variant)
FAL_MODEL_ID="fal-ai/flux-lora"
# Overall budget covering submit + queue polling + response fetch (ms).
FAL_TIMEOUT_MS="300000"
# Interval between queue status polls (ms).
FAL_POLL_MS="2000"
# Inference knobs. Defaults match the FLUX recommended settings; tune per
# model/LoRA combination.
FAL_STEPS="28"
FAL_GUIDANCE="3.5"
# fal accepts either a named preset (portrait_4_3, square_hd, landscape_16_9,
# …) or a {width, height} object — to pass a custom size set FAL_IMAGE_SIZE
# to a preset name here and pass {width,height} via code if needed.
FAL_IMAGE_SIZE="portrait_4_3"

# Optional: HuggingFace or S3 URL to your LoRA safetensors file. This is what
# actually makes the model produce the Fashion For Everyone style.
# e.g. https://huggingface.co/<user>/<repo>/resolve/main/<file>.safetensors
LORA_URL=""
# Strength of the LoRA (typical range 0.6–1.0). Higher = more adherence to
# the fine-tune at the cost of some prompt flexibility.
LORA_STRENGTH="0.85"

# Optional: comma-separated allowlist of HTTPS hosts the image URL may come
# from. fal usually serves from fal.media / v3.fal.media. Leave empty for a
# permissive default in dev.
# ALLOWED_IMAGE_HOSTS="fal.media,v3.fal.media"

# -----------------------------------------------------------------------------
# Networking / rate limiting
# -----------------------------------------------------------------------------
# Set to "true" only when behind a trusted reverse proxy (Vercel, Cloudflare,
# Nginx) so X-Forwarded-For can be trusted for IP-based rate limiting.
TRUST_PROXY="false"

# Token bucket per key. CAPACITY is the burst, REFILL_PER_SEC is the steady
# rate. Defaults: 10 burst, 0.1/s refill (i.e. 1 every 10 seconds).
RATE_LIMIT_CAPACITY="10"
RATE_LIMIT_REFILL_PER_SEC="0.1"
